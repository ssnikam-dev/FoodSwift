# Only the endpoints the Angular app uses are public.
{$API_DOMAIN} {
    encode gzip

    @frontend path /restaurant/fetchAllRestaurants /foodCatalogue/fetchRestaurantAndFoodItemsById/* /order/saveOrder
    handle @frontend {
        reverse_proxy /restaurant/* restaurant-service:9091
        reverse_proxy /foodCatalogue/* foodcatalogue-service:9092
        reverse_proxy /order/* order-service:9094
    }

    handle {
        respond "Not found" 404
    }
}
